# Deployer private key (hex, no 0x prefix required by some tools — include it to be safe)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# BOT Chain Mainnet RPC (default: https://rpc.botchain.ai)
RPC_URL=https://rpc.botchain.ai

# Block-explorer API key for contract verification on BOTScan
BOTCHAIN_EXPLORER_API_KEY=YOUR_EXPLORER_API_KEY

# ArbitratorMultisig signers (used during deployment / multisig setup)
ARBITRATOR_1=0xADDRESS_OF_ARBITRATOR_1
ARBITRATOR_2=0xADDRESS_OF_ARBITRATOR_2
ARBITRATOR_3=0xADDRESS_OF_ARBITRATOR_3
