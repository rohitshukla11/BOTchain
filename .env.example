# Deployer private key. Must be one of ARBITRATOR_1/2/3 below — ArbitratorMultisig
# gates setClaimNFT/setClaimVault on multisig ownership, not on Ownable.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Per-network RPC overrides (optional — these are the defaults).
# Do NOT use a single shared RPC_URL: it will point one network at the other's
# chain ID and every request fails the chain-ID check.
BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life

# Guard against deploying to the wrong chain. scripts/deploy.ts refuses to run
# unless the connected chain matches. 677 = Mainnet, 968 = Testnet.
EXPECTED_CHAIN_ID=677

# Block-explorer API key for contract verification on BOTScan
BOTCHAIN_EXPLORER_API_KEY=YOUR_EXPLORER_API_KEY

# ArbitratorMultisig signers (2-of-3). Exactly three, all distinct, none zero.
ARBITRATOR_1=0xADDRESS_OF_ARBITRATOR_1
ARBITRATOR_2=0xADDRESS_OF_ARBITRATOR_2
ARBITRATOR_3=0xADDRESS_OF_ARBITRATOR_3

# Challenge window before investors can be paid out, in seconds.
CHALLENGE_WINDOW_SECONDS=300

# Test fixtures applied at the end of deploy: comma-separated addresses.
# The deployer is always allowlisted and always minted; these are additional.
TEST_ORIGINATORS=0xORIGINATOR_ONE,0xORIGINATOR_TWO
TEST_INVESTORS=0xINVESTOR_ONE
TEST_MINT_AMOUNT=1000000
